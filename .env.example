# RateGuard environment template.
# Copy to .env and replace every "replace-with..." placeholder.
# .env is gitignored: never commit it or paste its contents into a ticket.
#
# Generate secrets (48 random bytes -> 64 base64 chars):
#   bash:       openssl rand -base64 48
#   PowerShell: $r = [System.Security.Cryptography.RandomNumberGenerator]::Create();
#               $b = New-Object byte[] 48; $r.GetBytes($b);
#               [Convert]::ToBase64String($b)
# ADMIN_API_KEY must be at least 16 chars; SESSION_SECRET at least 32.
# Use base64 output only: characters like $, #, or quotes can confuse parsers.

# --- Application -----------------------------------------------------------
APP_ENV=development
PORT=8080
STORE_BACKEND=memory
PROXY_UPSTREAM_URL=http://demo:8090
DEMO_ENABLED=true
# false for http://localhost; true only when served over HTTPS.
COOKIE_SECURE=false
ADMIN_API_KEY=replace-with-32-plus-random-chars
SESSION_SECRET=replace-with-32-plus-random-chars
LOG_LEVEL=info

# --- Caddy -----------------------------------------------------------------
# "localhost" serves plain HTTP. A real DNS name enables automatic HTTPS.
DOMAIN=localhost

# --- Docker image tag (optional) ------------------------------------------
# docker-compose.yml uses rateguard:${IMAGE_TAG:-local}.
# IMAGE_TAG=local

# --- AWS / EC2 / DynamoDB (uncomment for the EC2 deployment) --------------
# APP_ENV=production
# STORE_BACKEND=dynamodb
# AWS_REGION=ap-south-1
# SSM_ENABLED=true
# SSM_PARAM_PREFIX=/api-guard
# DYNAMODB_TENANTS_TABLE=api_guard_tenants
# DYNAMODB_USAGE_TABLE=api_guard_usage
# DYNAMODB_ANOMALIES_TABLE=api_guard_cost_anomalies
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:rateguard-alerts
# PROXY_UPSTREAM_URL=https://your-real-upstream.example.com
# DEMO_ENABLED=false
# COOKIE_SECURE=true
# DOMAIN=guard.example.com
#
# No AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here: the EC2 instance role
# supplies credentials. Do not put static AWS keys in .env.

# --- Tuning (optional) -----------------------------------------------------
# USAGE_FLUSH_INTERVAL=10s
# USAGE_BATCH_SIZE=100
# DYNAMODB_ENDPOINT=http://dynamodb-local:8000
