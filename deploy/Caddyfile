# RateGuard edge proxy.
#
# DOMAIN is injected by docker-compose.yml (default: localhost).
#   localhost      -> plain HTTP on :80 (no local certificate)
#   guard.example  -> automatic HTTPS via Let's Encrypt, HTTP redirects to HTTPS
#
# Caddy needs inbound TCP 80/443 (and optional UDP 443) plus outbound
# network access for ACME. Certificates live in the caddy_data volume.

{$DOMAIN:localhost} {
	encode zstd gzip

	# The Go app sets CSP, nosniff, frame/referrer/permissions policies.
	# HSTS is added here so it also applies to TLS-terminated local runs.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy api:8080
}
